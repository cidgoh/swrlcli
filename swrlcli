#!/usr/bin/env bash
# Wrapper for SWRLCLI.
# Usage: swrlcli [options] <ontology.owl|ofn>
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$SCRIPT_DIR/target/swrlcli-1.0.0-jar-with-dependencies.jar"

if [ ! -f "$JAR" ]; then
  echo "Error: fat JAR not found. Run 'mvn clean package' in $SCRIPT_DIR first." >&2
  exit 1
fi

exec java -cp "$JAR" org.swrltab.ui.SWRLCLI "$@"
